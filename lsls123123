local function getHPColor(hp)
    if vars.espHealthGradient then if hp > 0.5 then return vars.espHealthMid:Lerp(vars.espHealthHigh, (hp-0.5)*2) else return vars.espHealthLow:Lerp(vars.espHealthMid, hp*2) end
