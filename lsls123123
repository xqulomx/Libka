-- Auto Farm
local function findNearestFarmTarget()
    local char = LocalPlayer.Character; if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart"); if not root then return nil end
    local resources = Workspace:FindFirstChild("Resources"); if not resources then return nil end
    local nearest, nearestDist = nil, vars.farmRadius
    for _, resource in pairs(resources:GetChildren()) do
        local target = resource:FindFirstChild("Marker") or resource:FindFirstChild("Trunk")
        if target and target:IsA("BasePart") then local dist = (target.Position - root.Position).Magnitude
            if dist < nearestDist then nearestDist = dist; nearest = {marker = target, resource = resource} end end
    end
    return nearest
end

local function hitFarmTarget(target)
    if not target then return false end
    local char = LocalPlayer.Character; if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart"); if not root then return false end
    local remote = ReplicatedStorage.Remotes.RemoteEvent
    local args = {"Melee Hit-SF", false, target.marker, CFrame.new(root.Position, target.marker.Position), target.marker.Material or Enum.Material.Wood, 1, false, target.resource, false, 32, 23, 15, 21, 12, 21, 23, 4, 16, 32, 43, 33, 45, 44, 26, 15, 10, 18, 47, 15, 18, 2, 1, 44, 3, 41, 16, 30, 7, 13, 28, 36, 41, 50, 31, 12, 41, 47, 26, 40, 8}
    pcall(function() remote:FireServer(unpack(args)) end)
    return true
end

local function startFarm()
    if vars.farmConn then return end
    vars.farmConn = RunService.Heartbeat:Connect(function()
        if not vars.farmEnabled then farmMarker.Visible = false; return end
        local now = tick(); if now - vars.farmLastHit < vars.farmDelay then return end
        local target = findNearestFarmTarget()
        if target then hitFarmTarget(target); vars.farmLastHit = now
