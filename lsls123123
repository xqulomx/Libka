    if input.UserInputType == getKeyEnum(vars.silentAimKey) or input.KeyCode == getKeyEnum(vars.silentAimKey) then if vars.silentAimEnabled then vars.silentAimActive = true; vars.silentAimTarget = getClosest(vars.silentAimFOV, "Head") end end
