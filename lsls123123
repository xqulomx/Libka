    for _, model in pairs(folder:GetChildren()) do
        if not model:IsA("Model") or model.Name == LocalPlayer.Name then continue end
        local head, root = model:FindFirstChild("Head"), model:FindFirstChild("HumanoidRootPart")
        if not head or not root then continue end
        local dist = (head.Position - Camera.CFrame.Position).Magnitude; if dist > vars.espMaxDist then continue end
        local pos = Camera:WorldToViewportPoint(head.Position); if pos.Z <= 0 then continue end
        local rootPos = Camera:WorldToViewportPoint(root.Position)
        local boxH = math.abs(pos.Y - rootPos.Y) * 2.8; local boxW = boxH / 1.8; local x, y = pos.X - boxW/2, pos.Y - boxH * 0.05
        seen[model] = true
        if not vars.espObjects[model] then vars.espObjects[model] = {} end
        local obj = vars.espObjects[model]
        
        if vars.espBoxes then
            if not obj.Outline then obj.Outline = Drawing.new("Square"); obj.Outline.Filled = false; obj.Outline.Color = Color3.fromRGB(0,0,0); obj.Outline.Thickness = 4 end
            obj.Outline.Visible = true; obj.Outline.Position = Vector2.new(x-1, y-1); obj.Outline.Size = Vector2.new(boxW+2, boxH+2)
            if not obj.Box then obj.Box = Drawing.new("Square"); obj.Box.Filled = false; obj.Box.Thickness = vars.espBoxThickness end
            obj.Box.Visible = true; obj.Box.Color = vars.espBoxColor; obj.Box.Position = Vector2.new(x, y); obj.Box.Size = Vector2.new(boxW, boxH)
            if vars.espBoxFill then if not obj.BoxFill then obj.BoxFill = Drawing.new("Square"); obj.BoxFill.Filled = true end; obj.BoxFill.Visible = true; obj.BoxFill.Color = vars.espBoxFillColor; obj.BoxFill.Transparency = vars.espBoxFillAlpha; obj.BoxFill.Position = Vector2.new(x, y); obj.BoxFill.Size = Vector2.new(boxW, boxH) elseif obj.BoxFill then obj.BoxFill.Visible = false end
        elseif obj.Box then obj.Box.Visible = false; if obj.Outline then obj.Outline.Visible = false end; if obj.BoxFill then obj.BoxFill.Visible = false end end
        
        if vars.espHealthBar then
            local hum = model:FindFirstChildOfClass("Humanoid"); local hp = hum and (hum.Health/hum.MaxHealth) or 1; local hpColor = getHPColor(hp)
            local bx, by, bw, bh, thick = 0,0,0,0, vars.espHealthThick
            if vars.espHealthPos == "Left" then bx, by, bw, bh = x-thick-5, y, thick, boxH
            elseif vars.espHealthPos == "Right" then bx, by, bw, bh = x+boxW+5, y, thick, boxH else bx, by, bw, bh = x, y+boxH+3, boxW, thick end
            if not obj.HBg then obj.HBg = Drawing.new("Square"); obj.HBg.Filled = true end
            obj.HBg.Visible = true; obj.HBg.Color = Color3.fromRGB(20,20,20); obj.HBg.Position = Vector2.new(bx, by); obj.HBg.Size = Vector2.new(bw, bh)
            if not obj.HFill then obj.HFill = Drawing.new("Square"); obj.HFill.Filled = true end
            obj.HFill.Visible = true; obj.HFill.Color = hpColor
            if vars.espHealthPos == "Left" or vars.espHealthPos == "Right" then local fh = bh*hp; obj.HFill.Position = Vector2.new(bx, by+bh-fh); obj.HFill.Size = Vector2.new(bw, fh)
            else local fw = bw*hp; obj.HFill.Position = Vector2.new(bx, by); obj.HFill.Size = Vector2.new(fw, bh) end
            if vars.espHealthText then if not obj.HTxt then obj.HTxt = Drawing.new("Text"); obj.HTxt.Center = true; obj.HTxt.Outline = true; obj.HTxt.OutlineColor = Color3.fromRGB(0,0,0) end; obj.HTxt.Visible = true; obj.HTxt.Text = math.floor(hp*100).."%"; obj.HTxt.Color = hpColor; obj.HTxt.Size = vars.espHealthTextSize; obj.HTxt.Position = Vector2.new(bx+bw/2, by-16) elseif obj.HTxt then obj.HTxt.Visible = false end
        elseif obj.HBg then obj.HBg.Visible = false; obj.HFill.Visible = false; if obj.HTxt then obj.HTxt.Visible = false end end
        
        if vars.espNames then if not obj.Nm then obj.Nm = Drawing.new("Text"); obj.Nm.Center = true; obj.Nm.Outline = true; obj.Nm.OutlineColor = Color3.fromRGB(0,0,0); obj.Nm.Font = 3 end; obj.Nm.Visible = true; obj.Nm.Text = model.Name; obj.Nm.Color = vars.espNamesColor; obj.Nm.Size = vars.espNamesSize; obj.Nm.Position = Vector2.new(pos.X, vars.espNamesPos=="Top" and y-20 or y+boxH+6) elseif obj.Nm then obj.Nm.Visible = false end
        if vars.espDistance then if not obj.Dst then obj.Dst = Drawing.new("Text"); obj.Dst.Center = true; obj.Dst.Outline = true; obj.Dst.OutlineColor = Color3.fromRGB(0,0,0) end; obj.Dst.Visible = true; obj.Dst.Text = math.floor(dist).."m"; obj.Dst.Color = vars.espDistColor; obj.Dst.Size = vars.espDistSize; local dy = vars.espDistPos=="Top" and y-(vars.espNames and vars.espNamesPos=="Top" and 38 or 20) or y+boxH+(vars.espNames and vars.espNamesPos=="Bottom" and 22 or 8); obj.Dst.Position = Vector2.new(pos.X, dy) elseif obj.Dst then obj.Dst.Visible = false end
        if vars.espWeapon then if not obj.Wep then obj.Wep = Drawing.new("Text"); obj.Wep.Center = true; obj.Wep.Outline = true; obj.Wep.OutlineColor = Color3.fromRGB(0,0,0) end; obj.Wep.Visible = true; local wep = getWeaponFromHolster(model); obj.Wep.Text = "["..wep.."]"; obj.Wep.Color = vars.espWeaponColor; obj.Wep.Size = vars.espWeaponSize; obj.Wep.Position = Vector2.new(pos.X, y+boxH+24) elseif obj.Wep then obj.Wep.Visible = false end
    end
    for model, obj in pairs(vars.espObjects) do if not seen[model] then for _, d in pairs(obj) do if d and d.Visible ~= nil then d.Visible = false end end end end
end

local function updateClothESP()
    if not vars.clothESP then return end
    if tick() - vars.clothLastUpdate < 1 then return end; vars.clothLastUpdate = tick()
    for _, l in pairs(vars.clothLabels) do if l and l.Parent then l:Destroy() end end; vars.clothLabels = {}
    for _, h in pairs(vars.clothChamsTbl) do if h and h.Parent then h:Destroy() end end; vars.clothChamsTbl = {}
    local char = LocalPlayer.Character; if not char then return end
    local rp = char:FindFirstChild("HumanoidRootPart"); if not rp then return end
    local folder = Workspace:FindFirstChild("ClothPlants"); if not folder then return end
    for _, cloth in pairs(folder:GetChildren()) do
        if cloth:IsA("BasePart") or cloth:IsA("Model") then
            local p = cloth:IsA("Model") and cloth:GetPivot().Position or cloth.Position
            local d = (p - rp.Position).Magnitude
            if d <= vars.clothRange then
                if vars.clothChams then local hl = Instance.new("Highlight"); hl.FillColor = vars.clothColor; hl.OutlineColor = Color3.new(0,255,0); hl.FillTransparency = 0.5; hl.OutlineTransparency = 0.3; hl.Parent = cloth:IsA("Model") and (cloth:FindFirstChildWhichIsA("BasePart") or cloth) or cloth; table.insert(vars.clothChamsTbl, hl) end
                if vars.clothDist then local bb = Instance.new("BillboardGui"); bb.AlwaysOnTop = true; bb.Size = UDim2.new(0,100,0,30); bb.StudsOffset = Vector3.new(0,3,0); bb.Parent = cloth:IsA("Model") and (cloth:FindFirstChildWhichIsA("BasePart") or cloth) or cloth; local l = Instance.new("TextLabel", bb); l.BackgroundTransparency = 1; l.TextColor3 = vars.clothColor; l.TextSize = 12; l.Font = Enum.Font.GothamBold; l.Size = UDim2.new(1,0,1,0); l.Text = "Cloth\n"..math.floor(d).."m"; table.insert(vars.clothLabels, bb) end
            end
        end
    end
end

