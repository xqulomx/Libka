-- NoSpread + RapidFire
local function applyGunMods()
    local success, Items = pcall(function() return ModuleLoader:Load("Items") end)
    if not success or not Items then return end
    for gunName, gunStats in pairs(Items) do
        if type(gunStats) == "table" then
            if vars.noSpread then
                if gunStats.Spread then gunStats.Spread = 0 end
                if gunStats.ProjectileStats then
                    if gunStats.ProjectileStats.Spread then gunStats.ProjectileStats.Spread = 0 end
                    if gunStats.ProjectileStats.WeaponSpread then gunStats.ProjectileStats.WeaponSpread = 0 end
                end
                if gunStats.AmmoStats then for _, ammo in pairs(gunStats.AmmoStats) do
                    if type(ammo) == "table" then if ammo.Spread then ammo.Spread = 0 end; if ammo.WeaponSpread then ammo.WeaponSpread = 0 end end
                end end
            end
            if vars.rapidFire and gunStats.RPM then gunStats.RPM = gunStats.RPM * vars.rapidFireMult end
        end
    end
end

-- Melee Aura
local function getNearestEnemyPart()
    local char = LocalPlayer.Character; if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart"); if not root then return nil end
    local folder = Workspace:FindFirstChild("Players"); if not folder then return nil end
    local nearest, nearestDist = nil, vars.meleeAuraRange
    for _, model in pairs(folder:GetChildren()) do
        if model:IsA("Model") and model.Name ~= LocalPlayer.Name then
            local part = model:FindFirstChild(vars.meleeAuraHitbox)
            if part then local dist = (part.Position - root.Position).Magnitude
                if dist < nearestDist then nearestDist = dist; nearest = {part = part, model = model} end end
        end
    end
    return nearest
end

