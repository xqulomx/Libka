-- Freecam
function toggleFreecam(enabled)
    vars.freecam = enabled
    if enabled then
        local char = LocalPlayer.Character; if not char then return end
        vars.freecamLastSubject = Camera.CameraSubject; vars.freecamLastCFrame = Camera.CFrame
        vars.freecamPart = Instance.new("Part", Workspace); vars.freecamPart.Name = "FreecamPart"; vars.freecamPart.Size = Vector3.new(1,1,1); vars.freecamPart.Position = Camera.CFrame.Position; vars.freecamPart.Anchored = true; vars.freecamPart.CanCollide = false; vars.freecamPart.Transparency = 1
        Camera.CameraSubject = vars.freecamPart; Camera.CFrame = vars.freecamLastCFrame
        if vars.freecamConn then return end
        vars.freecamConn = RunService.RenderStepped:Connect(function(dt)
            if not vars.freecam then return end
            local mv = Vector3.zero
            if UserInputService:IsKeyDown(Enum.KeyCode.W) then mv += Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then mv -= Camera.CFrame.LookVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then mv -= Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then mv += Camera.CFrame.RightVector end
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then mv += Vector3.new(0,1,0) end
            if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then mv -= Vector3.new(0,1,0) end
            local spd = mv.Y ~= 0 and vars.freecamSpdY or vars.freecamSpd
            if mv.Magnitude > 0 then Camera.CFrame += mv.Unit * spd * dt end
        end)
    else
        if vars.freecamConn then vars.freecamConn:Disconnect(); vars.freecamConn = nil end
        if vars.freecamPart then vars.freecamPart:Destroy(); vars.freecamPart = nil end
        if vars.freecamLastSubject then Camera.CameraSubject = vars.freecamLastSubject end
        if vars.freecamLastCFrame then Camera.CFrame = vars.freecamLastCFrame end
    end
end

