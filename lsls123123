local function getClosest(fov, hitbox)
    local c, cd = nil, fov; local mp = UserInputService:GetMouseLocation()
    for _, m in pairs(Workspace.Players:GetChildren()) do
        if m:IsA("Model") and m ~= LocalPlayer.Character then
            local p = m:FindFirstChild(hitbox)
            if p then local sp = Camera:WorldToViewportPoint(p.Position)
                if sp.Z > 0 then local d = (Vector2.new(sp.X,sp.Y)-mp).Magnitude
                    if d < cd then cd = d; c = m end end end
        end
    end
    return c
end

